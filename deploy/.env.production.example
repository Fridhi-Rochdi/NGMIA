# Production configuration. Copy to deploy/.env and fill every value marked
# REQUIRED. Never commit the filled-in file.

# --- Domain and certificates (REQUIRED) -----------------------------------
# DNS: point app.<domaine>, api.<domaine>, admin.<domaine> and <domaine> to
# the server's IP before the first start; Caddy then issues the certificates.
DOMAIN=example.com
ACME_EMAIL=admin@example.com

# --- Database (REQUIRED) --------------------------------------------------
POSTGRES_USER=nextgen
# openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=nextgen

# --- Secrets (REQUIRED) -----------------------------------------------------
# openssl rand -hex 48   (one value each, never reused from development)
JWT_SECRET=
OTP_PEPPER=
JWT_EXPIRATION=15m
REFRESH_TOKEN_TTL_SECONDS=2592000

# Super administrator of the admin console
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- AI providers (REQUIRED) -------------------------------------------------
# Set a monthly budget and an alert on the OpenAI dashboard (Limits):
# an empty balance stops every generation.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_TRANSPARENT_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
NVIDIA_NIM_TEXT_MODEL=gpt-4o-mini
NVIDIA_NIM_SOCIAL_MODEL=gpt-4o-mini
NVIDIA_NIM_POSTER_MODEL=gpt-5.4
NVIDIA_NIM_WEBSITE_MODEL=gpt-5.4
NVIDIA_NIM_BRANDING_MODEL=gpt-4o-mini
# Optional fallback for images
NVIDIA_NIM_API_KEY=

# Voice-over for reels (optional while reels are hidden)
TTS_API_KEY=
TTS_BASE_URL=https://api.openai.com/v1
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy
HEYGEN_API_KEY=

# --- E-mail (REQUIRED: sign-in codes and password resets) --------------------
# Use a transactional provider (Brevo, Postmark, Resend...) with a verified
# sending domain, not a personal mailbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="NextGen Marketing <no-reply@example.com>"

# --- Payments (REQUIRED to sell) -------------------------------------------
# Live keys (sk_live_...). Webhook endpoint to declare in Stripe:
#   https://api.<domaine>/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Social networks (REQUIRED for automatic publishing) ---------------------
# Redirect URI to declare in each developer app:
#   https://api.<domaine>/social/oauth/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# --- Behaviour ---------------------------------------------------------------
DEFAULT_TIMEZONE=Europe/Paris
AUTO_POST_ENABLED=true
OTP_ENABLED=true
# Contact form recipient (/contact)
CONTACT_EMAIL=
