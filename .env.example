# ============================================
# NextGen MarketingAI — Environment Variables
# ============================================
# Copy to .env (root) and backend/.env, then fill in real values.
# Precedence: the backend loads backend/.env first, then ../.env as a fallback,
# so a variable defined in backend/.env always wins.

# ---- App ----
APP_NAME=NextGen MarketingAI
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
NODE_ENV=development
# Comma-separated list of origins allowed by CORS. The admin console runs on
# its own port and is a separate origin: leave it out and every call it makes
# is blocked by the browser.
FRONTEND_URL=http://localhost:3000,http://localhost:3100

# ---- Database (PostgreSQL) ----
# DATABASE_URL is the only one Prisma reads; the DATABASE_* parts below are
# informational and must stay consistent with it.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nextgen_marketingai?schema=public
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=nextgen_marketingai
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres

# ---- Auth ----
# REQUIRED: the app refuses to boot without it. Generate a strong random value,
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"`
JWT_SECRET=
# Duration format only: 15m, 24h, 7d…
JWT_EXPIRATION=24h

# Bootstrap super-admin: on first login with this email, the user and an "admin"
# tenant are created using ADMIN_PASSWORD. Leave empty to disable.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI: NVIDIA NIM (real integration) ----
# REQUIRED for every generation feature. https://build.nvidia.com
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Text models (per use case; all fall back to NVIDIA_NIM_TEXT_MODEL)
NVIDIA_NIM_TEXT_MODEL=moonshotai/kimi-k3
NVIDIA_NIM_WEBSITE_MODEL=moonshotai/kimi-k3
NVIDIA_NIM_BRANDING_MODEL=z-ai/glm-5.2
NVIDIA_NIM_POSTER_MODEL=z-ai/glm-5.2
NVIDIA_NIM_TOP_P=0.95
AI_MAX_TOKENS=1024
AI_TEMPERATURE=0.7
NVIDIA_NIM_TEXT_ATTEMPTS=3
# Floor for one text call. The real budget is computed from the tokens asked
# for (~15 tok/s), then clamped to the MAX below.
NVIDIA_NIM_TEXT_TIMEOUT_MS=120000
NVIDIA_NIM_TEXT_TIMEOUT_MAX_MS=300000
# Attempts allowed when generating a brand logo before giving up.
LOGO_ATTEMPTS=3

# Image provider: openai | nvidia | auto (default: OpenAI first when OPENAI_API_KEY
# is set, NVIDIA FLUX as fallback).
IMAGE_PROVIDER=auto
# OpenAI image model (needs OPENAI_API_KEY). Quality: low | medium | high.
OPENAI_IMAGE_MODEL=gpt-image-2
# Logos need a transparent background, which gpt-image-2 does not support
OPENAI_IMAGE_TRANSPARENT_MODEL=gpt-image-1.5
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_TIMEOUT_MS=180000
# Retries on a rate limit or a 5xx before falling back to the other provider
OPENAI_IMAGE_ATTEMPTS=3

# Image generation (FLUX by Black Forest Labs)
NVIDIA_NIM_IMAGE_BASE_URL=https://ai.api.nvidia.com/v1/genai
NVIDIA_NIM_IMAGE_MODEL=black-forest-labs/flux.1-schnell
NVIDIA_NIM_IMAGE_ATTEMPTS=2
# Diffusion steps for photography. 8 is enough for a dish or an interior:
# residual noise reads as grain.
NVIDIA_NIM_IMAGE_STEPS=8
# Steps for brand logos, which need far more. A flat vector mark has nowhere
# to hide an unfinished denoise, so below ~20 every logo comes back as a soft
# grey blob. Floored at 20 in code.
NVIDIA_NIM_LOGO_STEPS=30
# Ceiling on how many dish photographs one menu generation may commission.
MENU_PHOTO_BUDGET_MAX=12
NVIDIA_NIM_IMAGE_TIMEOUT_MS=60000
NVIDIA_NIM_POSTER_IMAGE_ENABLED=true

# Quotas IA mensuels par offre, en crédits (-1 = illimité). Chaque génération
# coûte 1 (texte) à 8 (reel) crédits ; au-delà, l'API répond 402.
# Défauts : FREE=30, STARTER=300, PRO=1500, ENTERPRISE=-1.
AI_QUOTA_FREE=30
AI_QUOTA_STARTER=300
AI_QUOTA_PRO=1500
AI_QUOTA_ENTERPRISE=-1
# Optional explicit invoke endpoints, tried before the defaults.
# NVIDIA_NIM_IMAGE_URL=
# NVIDIA_NIM_IMAGE_URLS=

# ---- Deployment: Vercel (publishing generated websites) ----
# Needs a token allowed to create projects. Without it, publishing fails.
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# ---- Reels: voix off (TTS) ----
# The reel script writes a spoken line per scene; this is what says it out loud.
# Providers are tried in this order and the chain degrades rather than failing:
# with none of them set, a Windows host still uses its built-in voices, and any
# other host encodes the reel silent (and says so on the reel's status).
#
#   1. ELEVENLABS_API_KEY          best quality, real advertising read
#   2. TTS_API_KEY + TTS_BASE_URL  any OpenAI-compatible /audio/speech endpoint
#   3. (nothing)                   Windows System.Speech, no credentials
ELEVENLABS_API_KEY=
# Defaults to "Rachel". Pick another at elevenlabs.io/voice-library.
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# OpenAI-compatible alternative. BASE_URL has no trailing slash and no /audio.
# TTS_BASE_URL=https://api.openai.com/v1
# TTS_API_KEY=
# TTS_MODEL=tts-1
# TTS_VOICE=alloy
# Windows fallback only: -10 (slowest) to 10 (fastest). 1 reads like an advert.
TTS_SAPI_RATE=1

# ---- Reseaux sociaux: publication automatique ----
# Le planificateur editorial publie tout seul les evenements ARMES et arrives a
# echeance. Sans identifiants ci-dessous, la connexion d une plateforme est
# refusee explicitement — l application ne fabrique plus de faux jetons.
#
# Redirection a declarer dans CHAQUE application plateforme:
#   <PUBLIC_API_URL>/social/oauth/callback
#
# Facebook / Instagram passent par la meme application Meta.
# Une application ne peut pas publier sur un profil personnel: il faut une Page,
# et pour Instagram un compte professionnel lie a cette Page.
# Permissions demandees: pages_manage_posts, pages_show_list,
# pages_read_engagement, et pour Instagram instagram_basic +
# instagram_content_publish. Ces permissions exigent la verification metier et
# la revue de l application par Meta avant de fonctionner hors mode
# developpement.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
# Optionnels: par defaut Instagram reutilise l application Facebook.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=

# LinkedIn: produit "Share on LinkedIn", scope w_member_social.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# X: OAuth2 avec PKCE. L ecriture de posts demande un palier payant.
TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

# Coupe le planificateur sans toucher au reste (utile en preprod, ou lors d une
# restauration de base: republier d anciens evenements serait visible).
AUTO_POST_ENABLED=true

# ---- Payments: Stripe ----
# REQUIRED for the billing module. Without them checkout, the customer portal
# and the webhook all fail — the Billing tab is inert.
# Secret key: server-side only, never sent to a browser.
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint pointed at POST /billing/webhook.
# Entitlements are granted ONLY from a webhook whose signature verifies, so a
# wrong value here means paid subscriptions never activate.
# Local: `stripe listen --forward-to localhost:4000/billing/webhook` prints it.
STRIPE_WEBHOOK_SECRET=
# Publishable key. Not read by the backend; kept here as the single place the
# Stripe credentials are written down.
STRIPE_PUBLISHABLE_KEY=
STRIPE_CURRENCY=eur

# ---- Debug ----
# true = print full prompts/payloads/DTOs. Never enabled when NODE_ENV=production.
DEBUG_AI=false

# Base publique de cette API.
# OBLIGATOIRE en production : les documents publies (menus, sites, affiches)
# referencent leurs images en URL absolue sur cette base. Si elle pointe sur
# localhost, les images seront cassees pour tous vos visiteurs.
# Le serveur refuse de demarrer en production si elle vaut localhost.
PUBLIC_API_URL=http://localhost:4000

# ---- Frontend (frontend/.env.local) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=NextGen MarketingAI
# Base domain used to route sub.domain -> generated website.
NEXT_PUBLIC_BASE_DOMAIN=marketingai.dev

# ============================================
# Authentification - second facteur (OTP) et session
# ============================================
# OTP_ENABLED=false desactive le second facteur (login rend la session
# directement). Toute autre valeur, ou l'absence de variable, l'active.
OTP_ENABLED=true
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_RESENDS=3
# Sel serveur ajoute au code avant hachage. A changer en production.
OTP_PEPPER=changez-moi-en-production
# Developpement uniquement : renvoie le code dans la reponse HTTP pour pouvoir
# derouler le flux sans boite mail. Ignore si NODE_ENV=production.
OTP_EXPOSE_CODE=true

# Duree de vie du refresh token (30 jours). L'access token suit JWT_EXPIRATION.
REFRESH_TOKEN_TTL_SECONDS=2592000

# Cookies de session. Secure passe a true automatiquement en production.
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.example.com

# ============================================
# Envoi d'emails
# ============================================
# file = ecrit les messages dans storage/mail (defaut sans SMTP_HOST)
# smtp = envoi reel via nodemailer
MAIL_TRANSPORT=file
MAIL_FROM="NextGen MarketingAI <no-reply@localhost>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=

# --- Reels: presenter on camera (talking person, lip-synced) -------------
# HeyGen API key (https://app.heygen.com/settings -> API). Without it, reels
# fall back to brand photos under a synthetic voiceover.
HEYGEN_API_KEY=
# Optional: a HeyGen studio avatar instead of a presenter photographed for
# the business, and its gender (female|male) to match the voice.
HEYGEN_AVATAR_ID=
HEYGEN_AVATAR_GENDER=female
# Optional: force a voice; otherwise the first HeyGen voice in the brand language.
HEYGEN_VOICE_ID=
# off disables the presenter even with a key.
REEL_PRESENTER=auto
